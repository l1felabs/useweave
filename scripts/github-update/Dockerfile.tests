FROM node:22-bookworm-slim AS dependencies
WORKDIR /source
COPY npm/ npm/
WORKDIR /source/npm
RUN npm install --package-lock-only --ignore-scripts --omit=optional --no-audit --no-fund
FROM scratch AS lock
COPY --from=dependencies /source/npm/package-lock.json /package-lock.json
FROM dependencies AS check
RUN npm ci --ignore-scripts --omit=optional --no-audit --no-fund
RUN npm test > /test-results.log 2>&1 || (cat /test-results.log && exit 1)
FROM scratch AS output
COPY --from=check /source/npm/package-lock.json /package-lock.json
COPY --from=check /test-results.log /test-results.log
