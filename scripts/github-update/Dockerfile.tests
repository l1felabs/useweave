FROM node:22.23.3-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS source
WORKDIR /source
COPY npm/ npm/
COPY scripts/github-update/ scripts/github-update/
WORKDIR /source/npm
FROM source AS dependencies
RUN npm install --package-lock-only --ignore-scripts --omit=optional --no-audit --no-fund
FROM scratch AS lock
COPY --from=dependencies /source/npm/package-lock.json /package-lock.json
FROM source AS check
RUN npm ci --ignore-scripts --omit=optional --no-audit --no-fund
RUN node --check /source/scripts/github-update/sign-catalog.mjs
RUN npm test > /test-results.log 2>&1 || (cat /test-results.log && exit 1)
FROM scratch AS output
COPY --from=check /source/npm/package-lock.json /package-lock.json
COPY --from=check /test-results.log /test-results.log

FROM check AS pack
RUN mkdir -p /evidence && cd joinweave && npm pack --ignore-scripts --json --pack-destination /evidence > /evidence/joinweave-pack.json
RUN cp /test-results.log package-lock.json /evidence/ && node --version > /evidence/toolchain.txt && npm --version >> /evidence/toolchain.txt
FROM scratch AS release-artifact
COPY --from=pack /evidence/ /
