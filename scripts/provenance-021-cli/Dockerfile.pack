# Depot only (project 67m5m8tkxf). Tests the frozen lock, then packs the three
# JavaScript archives of the CLI 0.2.1 release. Never publishes.
# depot build --project 67m5m8tkxf --platform linux/amd64 -f scripts/provenance-021-cli/Dockerfile.pack --target archives --output type=local,dest=OUT .
FROM node:22.23.3-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS check
WORKDIR /source
COPY npm/ npm/
WORKDIR /source/npm
RUN npm ci --ignore-scripts --omit=optional --no-audit --no-fund
RUN npm test > /test-results.log 2>&1 || (cat /test-results.log && exit 1)
FROM check AS pack
RUN mkdir -p /evidence \
 && for w in cli mcp joinweave; do (cd "$w" && npm pack --ignore-scripts --json --pack-destination /evidence > "/evidence/$w-pack.json"); done \
 && cp /test-results.log package-lock.json /evidence/ && node --version > /evidence/toolchain.txt && npm --version >> /evidence/toolchain.txt
FROM scratch AS archives
COPY --from=pack /evidence/ /
